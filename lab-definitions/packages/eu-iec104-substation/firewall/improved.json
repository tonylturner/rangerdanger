{
  "schema_version": "0.1.0",
  "system": {
    "hostname": "containd",
    "mgmt": {
      "listenAddr": ":8080",
      "enableHTTP": true,
      "enableHTTPS": true,
      "httpListenAddr": ":8080",
      "httpsListenAddr": ":8443",
      "tlsCertFile": "/data/tls/server.crt",
      "tlsKeyFile": "/data/tls/server.key"
    },
    "ssh": {}
  },
  "interfaces": [
    {
      "name": "wan",
      "zone": "wan",
      "access": {}
    },
    {
      "name": "dmz",
      "zone": "dmz",
      "access": {}
    },
    {
      "name": "lan1",
      "zone": "lan1",
      "access": {}
    },
    {
      "name": "lan2",
      "zone": "lan2",
      "access": {}
    },
    {
      "name": "lan3",
      "zone": "lan3",
      "access": {
        "mgmt": true,
        "ssh": true
      }
    },
    {
      "name": "lan4",
      "zone": "lan4",
      "access": {}
    },
    {
      "name": "lan5",
      "zone": "lan5",
      "access": {}
    }
  ],
  "zones": [
    {
      "name": "wan",
      "description": "Enterprise Zone - untrusted student and attacker access"
    },
    {
      "name": "dmz",
      "description": "Vendor and Engineering Zone"
    },
    {
      "name": "lan1",
      "description": "Station Zone - IEC104 RTU, OpenPLC and GPS clock"
    },
    {
      "name": "lan2",
      "description": "Feeder Field Zone - breaker, RMUs and OLTC Modbus endpoints"
    },
    {
      "name": "lan3",
      "description": "RangerDanger control plane - backend and containd management"
    },
    {
      "name": "lan4",
      "description": "Control Centre Zone - IEC104 client"
    },
    {
      "name": "lan5",
      "description": "Operations DMZ - read-only historian"
    }
  ],
  "routing": {},
  "dataplane": {
    "dpiMode": "enforce",
    "nflogGroup": 100,
    "nfqueueGroup": 101,
    "dpiEnabled": false
  },
  "pcap": {
    "filter": {}
  },
  "firewall": {
    "defaultAction": "DENY",
    "rules": [
      {
        "id": "control-centre-to-rtu-iec104",
        "description": "Allow the named Control Centre to open IEC104 sessions to the RTU",
        "sourceZones": [
          "lan4"
        ],
        "destZones": [
          "lan1"
        ],
        "sources": [
          "10.60.60.20/32"
        ],
        "destinations": [
          "10.30.30.20/32"
        ],
        "protocols": [
          {
            "name": "tcp",
            "port": "2404"
          }
        ],
        "action": "ALLOW"
      },
      {
        "id": "rtu-to-feeder-modbus",
        "description": "Allow the named RTU to poll and control the breaker, RMUs and OLTC over Modbus TCP",
        "sourceZones": [
          "lan1"
        ],
        "destZones": [
          "lan2"
        ],
        "sources": [
          "10.30.30.20/32"
        ],
        "destinations": [
          "10.40.40.20/32",
          "10.40.40.21/32",
          "10.40.40.22/32",
          "10.40.40.23/32"
        ],
        "protocols": [
          {
            "name": "tcp",
            "port": "502"
          }
        ],
        "action": "ALLOW"
      },
      {
        "id": "plc-to-oltc-modbus",
        "description": "Allow only the named PLC to regulate the OLTC over Modbus TCP",
        "sourceZones": [
          "lan1"
        ],
        "destZones": [
          "lan2"
        ],
        "sources": [
          "10.30.30.30/32"
        ],
        "destinations": [
          "10.40.40.23/32"
        ],
        "protocols": [
          {
            "name": "tcp",
            "port": "502"
          }
        ],
        "action": "ALLOW"
      },
      {
        "id": "control-centre-to-historian-ingest",
        "description": "Allow only the named CC to push historian snapshots",
        "sourceZones": [
          "lan4"
        ],
        "destZones": [
          "lan5"
        ],
        "sources": [
          "10.60.60.20/32"
        ],
        "destinations": [
          "10.70.70.40/32"
        ],
        "protocols": [
          {
            "name": "tcp",
            "port": "8081"
          }
        ],
        "action": "ALLOW"
      },
      {
        "id": "enterprise-to-historian-read",
        "description": "Allow enterprise read-only historian access",
        "sourceZones": [
          "wan"
        ],
        "destZones": [
          "lan5"
        ],
        "sources": [
          "10.10.10.0/24"
        ],
        "destinations": [
          "10.70.70.40/32"
        ],
        "protocols": [
          {
            "name": "tcp",
            "port": "8080"
          }
        ],
        "action": "ALLOW"
      },
      {
        "id": "engineering-to-plc-web",
        "description": "Allow engineering maintenance of the OpenPLC web UI",
        "sourceZones": [
          "dmz"
        ],
        "destZones": [
          "lan1"
        ],
        "sources": [
          "10.20.20.20/32"
        ],
        "destinations": [
          "10.30.30.30/32"
        ],
        "protocols": [
          {
            "name": "tcp",
            "port": "8080"
          }
        ],
        "action": "ALLOW"
      },
      {
        "id": "deny-unauthorized-iec104",
        "description": "Deny and log other sources attempting to reach IEC104 on TCP/2404",
        "sourceZones": [
          "wan",
          "dmz",
          "lan1",
          "lan2",
          "lan3",
          "lan4",
          "lan5"
        ],
        "destZones": [
          "lan1"
        ],
        "protocols": [
          {
            "name": "tcp",
            "port": "2404"
          }
        ],
        "action": "DENY",
        "log": true
      },
      {
        "id": "deny-unauthorized-modbus",
        "description": "Deny and log other sources attempting to reach Modbus on TCP/502",
        "sourceZones": [
          "wan",
          "dmz",
          "lan1",
          "lan2",
          "lan3",
          "lan4",
          "lan5"
        ],
        "destZones": [
          "lan2"
        ],
        "protocols": [
          {
            "name": "tcp",
            "port": "502"
          }
        ],
        "action": "DENY",
        "log": true
      }
    ],
    "nat": {
      "enabled": false
    }
  },
  "ids": {
    "enabled": false
  },
  "services": {
    "syslog": {
      "forwarders": [],
      "format": "rfc5424",
      "batchSize": 500,
      "flushEvery": 2
    },
    "dns": {
      "enabled": false
    },
    "ntp": {
      "enabled": false
    },
    "proxy": {
      "forward": {
        "enabled": false
      },
      "reverse": {
        "enabled": false
      }
    },
    "dhcp": {
      "enabled": false
    },
    "vpn": {
      "wireguard": {
        "enabled": false
      },
      "openvpn": {
        "enabled": false
      }
    },
    "av": {
      "enabled": false,
      "icap": {},
      "clamav": {}
    }
  }
}
