{
  "schema": 1,
  "package": "eu-iec104-substation",
  "networks": [
    {
      "key": "mgmt_net",
      "name": "rangerdanger_mgmt_net",
      "subnet": "10.99.99.0/24",
      "gateway": "10.99.99.1",
      "platform": true
    },
    {
      "key": "enterprise_net",
      "name": "rangerdanger_enterprise_net",
      "subnet": "10.10.10.0/24",
      "gateway": "10.10.10.1",
      "zone": "enterprise_net"
    },
    {
      "key": "vendor_net",
      "name": "rangerdanger_vendor_net",
      "subnet": "10.20.20.0/24",
      "gateway": "10.20.20.1",
      "zone": "vendor_net"
    },
    {
      "key": "station_net",
      "name": "rangerdanger_station_net",
      "subnet": "10.30.30.0/24",
      "gateway": "10.30.30.1",
      "zone": "station_net"
    },
    {
      "key": "field_net",
      "name": "rangerdanger_field_net",
      "subnet": "10.40.40.0/24",
      "gateway": "10.40.40.1",
      "zone": "field_net"
    },
    {
      "key": "control_centre_net",
      "name": "rangerdanger_control_centre_net",
      "subnet": "10.60.60.0/24",
      "gateway": "10.60.60.1",
      "zone": "control_centre_net"
    },
    {
      "key": "process_net",
      "name": "rangerdanger_process_net",
      "subnet": "10.50.50.0/24",
      "gateway": "10.50.50.1"
    }
  ],
  "services": [
    {
      "key": "firewall",
      "container": "rangerdanger-firewall",
      "node": "fw-1",
      "roles": [
        "firewall"
      ],
      "interfaces": [
        {
          "network": "mgmt_net",
          "ipv4": "10.99.99.2"
        },
        {
          "network": "enterprise_net",
          "ipv4": "10.10.10.2"
        },
        {
          "network": "vendor_net",
          "ipv4": "10.20.20.2"
        },
        {
          "network": "station_net",
          "ipv4": "10.30.30.2"
        },
        {
          "network": "field_net",
          "ipv4": "10.40.40.2"
        },
        {
          "network": "control_centre_net",
          "ipv4": "10.60.60.2"
        }
      ],
      "endpoints": {
        "api": "http://10.99.99.2:8080"
      }
    },
    {
      "key": "kali",
      "container": "rangerdanger-kali",
      "node": "kali-1",
      "roles": [
        "attacker"
      ],
      "interfaces": [
        {
          "network": "enterprise_net",
          "ipv4": "10.10.10.50"
        }
      ]
    },
    {
      "key": "vendor_jump",
      "container": "rangerdanger-vendor-jump",
      "node": "vendor-jump-1",
      "roles": [
        "jump-host"
      ],
      "interfaces": [
        {
          "network": "vendor_net",
          "ipv4": "10.20.20.10"
        },
        {
          "network": "mgmt_net",
          "ipv4": "10.99.99.60"
        }
      ]
    },
    {
      "key": "eng_workstation",
      "container": "rangerdanger-eng-ws",
      "node": "eng-ws-1",
      "roles": [
        "engineering-ws"
      ],
      "interfaces": [
        {
          "network": "vendor_net",
          "ipv4": "10.20.20.20"
        },
        {
          "network": "mgmt_net",
          "ipv4": "10.99.99.61"
        }
      ]
    },
    {
      "key": "gps_sim",
      "container": "rangerdanger-gps-sim",
      "node": "gps-1",
      "roles": [
        "time-source"
      ],
      "interfaces": [
        {
          "network": "station_net",
          "ipv4": "10.30.30.50"
        }
      ]
    },
    {
      "key": "iec104_rtu",
      "container": "rangerdanger-iec104-rtu",
      "node": "rtu-1",
      "roles": [
        "rtu"
      ],
      "interfaces": [
        {
          "network": "station_net",
          "ipv4": "10.30.30.20"
        }
      ]
    },
    {
      "key": "control_centre",
      "container": "rangerdanger-control-centre",
      "node": "cc-1",
      "roles": [
        "control-centre"
      ],
      "interfaces": [
        {
          "network": "control_centre_net",
          "ipv4": "10.60.60.20"
        },
        {
          "network": "mgmt_net",
          "ipv4": "10.99.99.21"
        }
      ],
      "endpoints": {
        "api": "http://10.99.99.21:8080"
      }
    },
    {
      "key": "feeder_breaker",
      "container": "rangerdanger-feeder-breaker",
      "node": "breaker-1",
      "roles": [
        "field-device"
      ],
      "interfaces": [
        {
          "network": "field_net",
          "ipv4": "10.40.40.20"
        },
        {
          "network": "process_net",
          "ipv4": "10.50.50.30"
        },
        {
          "network": "mgmt_net",
          "ipv4": "10.99.99.22"
        }
      ],
      "endpoints": {
        "sim": "http://10.99.99.22:8080"
      }
    },
    {
      "key": "opendss_sim",
      "container": "rangerdanger-opendss-sim",
      "roles": [
        "process-solver"
      ],
      "interfaces": [
        {
          "network": "process_net",
          "ipv4": "10.50.50.20"
        },
        {
          "network": "mgmt_net",
          "ipv4": "10.99.99.23"
        }
      ],
      "endpoints": {
        "api": "http://10.99.99.23:8080"
      }
    }
  ]
}
