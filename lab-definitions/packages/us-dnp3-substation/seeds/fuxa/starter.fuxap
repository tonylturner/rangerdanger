        "variables": {},
        "svgcontent": "<svg width=\"760\" height=\"620\" xmlns=\"http://www.w3.org/2000/svg\"><g font-family=\"sans-serif\" fill=\"#17212b\">\n<text x=\"28\" y=\"42\" font-size=\"24\">US substation — RTAC monitor</text>\n<text x=\"28\" y=\"76\" font-size=\"16\">Read-only display · RTAC 10.30.30.20 · Modbus TCP · 2 s polling</text>\n<text x=\"28\" y=\"106\" font-size=\"16\">Workshop alarms and customer-service evidence: /substation</text>\n<line x1=\"28\" y1=\"134\" x2=\"732\" y2=\"134\" stroke=\"#c9d2db\"/>\n<text x=\"28\" y=\"160\" font-size=\"18\">Breaker closed</text>\n<text x=\"28\" y=\"180\" font-size=\"14\" fill=\"#425466\">1 = closed; 0 = open</text>\n<g id=\"VAL_breaker\" type=\"svg-ext-value\" fill=\"#17212b\" stroke-width=\"0\" font-size=\"22\" font-family=\"sans-serif\" text-anchor=\"end\"><text id=\"VAL_breaker_text\" x=\"716\" y=\"164\" font-size=\"22\" text-anchor=\"end\">---</text></g>\n<line x1=\"28\" y1=\"202\" x2=\"732\" y2=\"202\" stroke=\"#c9d2db\"/>\n<text x=\"28\" y=\"228\" font-size=\"18\">Recloser closed</text>\n<text x=\"28\" y=\"248\" font-size=\"14\" fill=\"#425466\">1 = closed; 0 = open</text>\n<g id=\"VAL_recloser\" type=\"svg-ext-value\" fill=\"#17212b\" stroke-width=\"0\" font-size=\"22\" font-family=\"sans-serif\" text-anchor=\"end\"><text id=\"VAL_recloser_text\" x=\"716\" y=\"232\" font-size=\"22\" text-anchor=\"end\">---</text></g>\n<line x1=\"28\" y1=\"270\" x2=\"732\" y2=\"270\" stroke=\"#c9d2db\"/>\n<text x=\"28\" y=\"296\" font-size=\"18\">Auto-reclose enabled</text>\n<text x=\"28\" y=\"316\" font-size=\"14\" fill=\"#425466\">1 = enabled; 0 = disabled</text>\n<g id=\"VAL_reclose\" type=\"svg-ext-value\" fill=\"#17212b\" stroke-width=\"0\" font-size=\"22\" font-family=\"sans-serif\" text-anchor=\"end\"><text id=\"VAL_reclose_text\" x=\"716\" y=\"300\" font-size=\"22\" text-anchor=\"end\">---</text></g>\n<line x1=\"28\" y1=\"338\" x2=\"732\" y2=\"338\" stroke=\"#c9d2db\"/>\n<text x=\"28\" y=\"364\" font-size=\"18\">Regulator tap</text>\n<text x=\"28\" y=\"384\" font-size=\"14\" fill=\"#425466\">Signed tap position</text>\n<g id=\"VAL_tap\" type=\"svg-ext-value\" fill=\"#17212b\" stroke-width=\"0\" font-size=\"22\" font-family=\"sans-serif\" text-anchor=\"end\"><text id=\"VAL_tap_text\" x=\"716\" y=\"368\" font-size=\"22\" text-anchor=\"end\">---</text></g>\n<line x1=\"28\" y1=\"406\" x2=\"732\" y2=\"406\" stroke=\"#c9d2db\"/>\n<text x=\"28\" y=\"432\" font-size=\"18\">Bus voltage (V)</text>\n<text x=\"28\" y=\"452\" font-size=\"14\" fill=\"#425466\">RTAC measurement</text>\n<g id=\"VAL_voltage\" type=\"svg-ext-value\" fill=\"#17212b\" stroke-width=\"0\" font-size=\"22\" font-family=\"sans-serif\" text-anchor=\"end\"><text id=\"VAL_voltage_text\" x=\"716\" y=\"436\" font-size=\"22\" text-anchor=\"end\">---</text></g>\n<line x1=\"28\" y1=\"474\" x2=\"732\" y2=\"474\" stroke=\"#c9d2db\"/>\n<text x=\"28\" y=\"500\" font-size=\"18\">Feeder current (A)</text>\n<text x=\"28\" y=\"520\" font-size=\"14\" fill=\"#425466\">RTAC measurement</text>\n<g id=\"VAL_current\" type=\"svg-ext-value\" fill=\"#17212b\" stroke-width=\"0\" font-size=\"22\" font-family=\"sans-serif\" text-anchor=\"end\"><text id=\"VAL_current_text\" x=\"716\" y=\"504\" font-size=\"22\" text-anchor=\"end\">---</text></g>\n<text x=\"28\" y=\"592\" font-size=\"14\" fill=\"#425466\">--- = awaiting data; check the device connection before recording evidence.</text></g></svg>"
