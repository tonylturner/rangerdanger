        "t_reclose": {
          "id": "t_reclose",
          "name": "Auto-reclose enabled",
          "type": "UInt16",
          "address": "3",
          "memaddress": "400000",
          "divisor": 1
        },
        "t_tap": {
          "id": "t_tap",
          "name": "Regulator tap",
          "type": "Int16",
          "address": "4",
          "memaddress": "400000",
          "divisor": 1
        },
        "t_voltage": {
          "id": "t_voltage",
          "name": "Bus voltage (V)",
          "type": "UInt16",
          "address": "1",
          "memaddress": "300000",
          "divisor": 10
        },
        "t_current": {
          "id": "t_current",
          "name": "Feeder current (A)",
          "type": "UInt16",
          "address": "4",
          "memaddress": "300000",
          "divisor": 10
        }
      }
    }
