FROM registry.access.redhat.com/ubi9/ubi:9.7@sha256:e9a31af6530caffa3551f266c51a0d43b602e8f76a0dc12826dbeebceb487c92 AS routing-tools
RUN mkdir /rootfs && dnf install --installroot /rootfs --releasever 9 --setopt install_weak_deps=false --nodocs -y iproute util-linux-core util-linux && dnf --installroot /rootfs clean all && rm -f /rootfs/etc/passwd* /rootfs/etc/group* /rootfs/etc/shadow* /rootfs/etc/gshadow*
FROM openziti/ziti-controller:2.0.8@sha256:834cb8a784b55716a56c0aab15d8809bc553834a534dbb8986d0711cb5c34dfc
USER root
COPY --from=routing-tools /rootfs/ /
COPY scripts/set-gateway.sh /usr/local/bin/set-gateway.sh
COPY services/sra/common/ /opt/sra/common/
COPY services/sra/ziti-controller/ /opt/sra/ziti-controller/
RUN mkdir -p /var/lib/sra /ziti-controller /run/sra/enrollment && chown -R 2171:2171 /var/lib/sra /ziti-controller && chmod +x /usr/local/bin/set-gateway.sh /opt/sra/common/*.sh /opt/sra/ziti-controller/*.sh
HEALTHCHECK --interval=5s --timeout=3s --start-period=30s --retries=24 CMD ["/opt/sra/ziti-controller/health.sh"]
ENTRYPOINT ["/opt/sra/ziti-controller/entrypoint.sh"]
CMD []
