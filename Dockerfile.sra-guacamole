FROM guacamole/guacamole:1.6.0@sha256:f344085e618bb05e22b964b0208dbd06d3468275bac70206f93805245e067b40
USER root
RUN apt-get update && apt-get install -y --no-install-recommends iproute2 util-linux postgresql-client && rm -rf /var/lib/apt/lists/* && groupadd -g 2172 sra-recordings && usermod -aG sra-recordings guacamole && mkdir -p /var/lib/sra && chown 1001:1001 /var/lib/sra
COPY scripts/set-gateway.sh /usr/local/bin/set-gateway.sh
COPY services/sra/common/ /opt/sra/common/
COPY services/sra/guacamole/ /opt/sra/guacamole/
RUN chmod +x /usr/local/bin/set-gateway.sh /opt/sra/common/*.sh /opt/sra/guacamole/*.sh
HEALTHCHECK --interval=5s --timeout=3s --start-period=120s --retries=24 CMD ["/opt/sra/guacamole/health.sh"]
ENTRYPOINT ["/opt/sra/guacamole/entrypoint.sh"]
CMD []
