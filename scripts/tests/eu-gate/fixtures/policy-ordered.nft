	}

	chain gate_out {
		type filter hook output priority mangle; policy accept;
		meta mark & 0x00800000 == 0x00800000 ct mark set ct mark | 0x00200000
	}

	chain input {
		type filter hook input priority filter; policy drop;
		iifname "lo" accept
		ct mark & 0x00100000 == 0x00100000 ct direction original goto gate_in
		ct state { established, related } accept
		ct state invalid drop
		iifname "lan3" ip saddr { 10.99.99.3, 10.99.99.10 } ip daddr 10.99.99.2 tcp dport 8080 accept
		ip protocol icmp icmp type { echo-reply, destination-unreachable, echo-request, time-exceeded } accept
		icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem, nd-neighbor-solicit, nd-neighbor-advert } accept
		iifname "lan3" tcp dport 8080 accept
		iifname "lan3" tcp dport 8443 accept
		iifname "lan3" tcp dport 2222 accept
	}

	chain forward {
		type filter hook forward priority filter; policy drop;
		ct mark & 0x00100000 == 0x00100000 drop
		meta mark & 0x04000000 == 0x00000000 ct state != { invalid, untracked } ct direction original iifname "lan4" oifname "lan1" meta l4proto tcp ct reply proto-src 2404 ct original ip saddr 10.60.60.20 ct reply ip saddr 10.30.30.20 counter name "rule_e1da780b3d078dba" jump iec104_monitor_queue
		meta mark & 0x04000000 == 0x00000000 ct state != { invalid, untracked } ct direction reply iifname "lan1" oifname "lan4" meta l4proto tcp ct reply proto-src 2404 ct original ip saddr 10.60.60.20 ct reply ip saddr 10.30.30.20 counter name "rule_e1da780b3d078dba" jump iec104_monitor_queue
		meta mark & 0x04000000 == 0x00000000 ct state { invalid, untracked } iifname "lan4" oifname "lan1" tcp dport 2404 ip saddr 10.60.60.20 ip daddr 10.30.30.20 counter name "rule_e1da780b3d078dba" jump iec104_monitor_queue
		meta mark & 0x04000000 == 0x00000000 ct state != { invalid, untracked } ct direction original iifname "lan4" oifname "lan1" meta l4proto tcp ct reply proto-src 2404 ct original ip saddr 10.60.60.20 ct reply ip saddr 10.30.30.20 counter name "rule_5d165ea7b43bf13b" jump iec104_monitor_queue
		meta mark & 0x04000000 == 0x00000000 ct state != { invalid, untracked } ct direction reply iifname "lan1" oifname "lan4" meta l4proto tcp ct reply proto-src 2404 ct original ip saddr 10.60.60.20 ct reply ip saddr 10.30.30.20 counter name "rule_5d165ea7b43bf13b" jump iec104_monitor_queue
		meta mark & 0x04000000 == 0x00000000 ct state { invalid, untracked } iifname "lan4" oifname "lan1" tcp dport 2404 ip saddr 10.60.60.20 ip daddr 10.30.30.20 counter name "rule_5d165ea7b43bf13b" jump iec104_monitor_queue
		meta mark & 0x04000000 == 0x00000000 ct state != { invalid, untracked } ct direction original iifname "lan4" oifname "lan1" meta l4proto tcp ct reply proto-src 2404 ct original ip saddr 10.60.60.20 ct reply ip saddr 10.30.30.20 counter name "rule_eac96547b5d0f078" jump iec104_monitor_queue
		meta mark & 0x04000000 == 0x00000000 ct state != { invalid, untracked } ct direction reply iifname "lan1" oifname "lan4" meta l4proto tcp ct reply proto-src 2404 ct original ip saddr 10.60.60.20 ct reply ip saddr 10.30.30.20 counter name "rule_eac96547b5d0f078" jump iec104_monitor_queue
		meta mark & 0x04000000 == 0x00000000 ct state { invalid, untracked } iifname "lan4" oifname "lan1" tcp dport 2404 ip saddr 10.60.60.20 ip daddr 10.30.30.20 counter name "rule_eac96547b5d0f078" jump iec104_monitor_queue
		meta mark & 0x10000000 != 0x00000000 goto ordered_s2
		ct state established ct mark & 0x00000007 == 0x00000006 goto admit_clean
		ct state != related goto ordered_s2
		ct state related goto related_clean
	}
}
