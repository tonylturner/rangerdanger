    "system": {
      "hostname": "containd",
      "mgmt": {
        "listenAddr": ":8080",
        "enableHTTP": true,
        "enableHTTPS": true,
        "httpListenAddr": ":8080",
        "httpsListenAddr": ":8443",
        "tlsCertFile": "/data/tls/server.crt",
        "tlsKeyFile": "/data/tls/server.key"
      },
      "ssh": {}
    },
    "zones": [
      {
        "name": "wan",
