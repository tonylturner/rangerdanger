# The range lifecycle runs the standalone Compose binary (no docker CLI).
# The index digest pins both architectures; BuildKit picks the platform's.
FROM docker:29.8.0-cli@sha256:eccaacfeed644c7de222ff047483568cb988dde95476fbaaf10ea2d04921bb66 AS compose

FROM golang:1.27 AS builder
WORKDIR /app
COPY backend/go.mod backend/go.sum ./backend/
COPY backend ./backend
WORKDIR /app/backend

# Build metadata injected via --build-arg from the release workflow.
# Local `docker build` without args yields the version package's
# defaults ("dev" / "none" / "unknown").
ARG VERSION=dev
ARG COMMIT=none
ARG DATE=unknown

RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    go build \
        -ldflags "-X github.com/tturner/rangerdanger/backend/internal/version.Version=${VERSION} \
                  -X github.com/tturner/rangerdanger/backend/internal/version.Commit=${COMMIT} \
                  -X github.com/tturner/rangerdanger/backend/internal/version.Date=${DATE}" \
        -o /bin/rangerdanger-backend ./cmd/server

FROM gcr.io/distroless/base-debian12
COPY --from=compose /usr/local/libexec/docker/cli-plugins/docker-compose /usr/local/bin/docker-compose
COPY --from=builder /bin/rangerdanger-backend /bin/rangerdanger-backend
# Compose runs from here; it must hold no Compose file (label-only down).
WORKDIR /app
EXPOSE 8080
ENTRYPOINT ["/bin/rangerdanger-backend"]
