# The upstream runtime is amd64-only; SSD staging must include this architecture.
FROM tuttas/openplc_v3:latest@sha256:94fb9e8387340af716211454664980dc0e97924067712cf573a1e467c3a37722

RUN apt-get update && apt-get install -y --no-install-recommends \
        iproute2 python3 sqlite3 \
    && rm -rf /var/lib/apt/lists/*

COPY lab-definitions/packages/eu-iec104-substation/seeds/openplc/ /opt/openplc-eu/
COPY scripts/openplc-eu-entrypoint.sh /openplc-eu-entrypoint.sh
COPY scripts/set-gateway.sh /usr/local/bin/set-gateway.sh
RUN chmod +x /openplc-eu-entrypoint.sh /usr/local/bin/set-gateway.sh \
    && cd /opt/openplc-eu \
    && sha256sum tap-control.st oltc.json install.py > seed.sha256

WORKDIR /root/OpenPLC_v3/webserver
ENTRYPOINT ["/openplc-eu-entrypoint.sh"]
