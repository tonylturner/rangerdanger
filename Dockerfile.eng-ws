FROM golang:1.27-alpine AS dnp3-builder
WORKDIR /src
COPY dnp3go/ .
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    CGO_ENABLED=0 go build -o /dnp3poll ./cmd/dnp3poll \
 && CGO_ENABLED=0 go build -o /dnp3cmd ./cmd/dnp3cmd

# ── iec104cmd (GPLv3) ────────────────────────────────────────────────
FROM alpine:3.22@sha256:5291449c3df73caf6ed85e649dec1b9e818b39a5d8c871e97afc13e9cd5e8fa8 AS iec104cmd-builder
RUN apk add --no-cache build-base curl linux-headers
COPY services/iec104/src/ /src/iec104/src/
COPY services/iec104/LICENSE /src/iec104/LICENSE
COPY services/iec104/README.md /src/iec104/README.md
COPY services/iec104/build-iec104cmd.sh /src/iec104/build-iec104cmd.sh
RUN /src/iec104/build-iec104cmd.sh /src/iec104 /out /tmp/iec104cmd

# webtop ubuntu-mate pinned by digest (A7).
FROM linuxserver/webtop:ubuntu-mate@sha256:db3e3c309152b4f2d0835ee570c5141d0868097efde235593ffa575055d95a82

# Install OT analysis tools and Modbus testing
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        iproute2 \
        mbpoll \
        nmap \
        python3 \
        python3-pip \
        tcpdump \
        tshark \
        wireshark && \
    pip3 install --no-cache-dir --break-system-packages pymodbus && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Install DNP3 CLI tools
COPY --from=dnp3-builder /dnp3poll /usr/local/bin/dnp3poll
COPY --from=dnp3-builder /dnp3cmd /usr/local/bin/dnp3cmd

# IEC 104 CLI (GPLv3), static binary plus its corresponding source and licence.
COPY --from=iec104cmd-builder /out/iec104cmd /usr/local/bin/iec104cmd
COPY --from=iec104cmd-builder /tmp/iec104cmd/lib60870.tar.gz /usr/share/src/iec104/lib60870.tar.gz
COPY --from=iec104cmd-builder /src/iec104/src/ /usr/share/src/iec104/src/
COPY --from=iec104cmd-builder /src/iec104/build-iec104cmd.sh /usr/share/src/iec104/build-iec104cmd.sh
COPY --from=iec104cmd-builder /src/iec104/LICENSE /usr/share/licenses/iec104/LICENSE
COPY --from=iec104cmd-builder /src/iec104/README.md /usr/share/licenses/iec104/README.md

# Create MATE desktop shortcuts and a pcaps directory
RUN mkdir -p /config/Desktop /home/abc/pcaps && \
    printf '%s\n' \
        '[Desktop Entry]' \
        'Type=Application' \
        'Name=Wireshark' \
        'Comment=Network Protocol Analyzer' \
        'Exec=wireshark' \
        'Icon=wireshark' \
        'Terminal=false' \
        'Categories=Network;' \
        > /config/Desktop/wireshark.desktop && \
    printf '%s\n' \
        '[Desktop Entry]' \
        'Type=Application' \
        'Name=PCAP Analyzer' \
        'Comment=EmberOT OT PCAP Analyzer' \
        'Exec=sh -c "exec $(find /opt -name \"pcap-analyzer\" -o -name \"PCAP Analyzer\" 2>/dev/null | head -1) || echo No PCAP Analyzer found"' \
        'Terminal=false' \
        'Categories=Network;' \
        > /config/Desktop/pcap-analyzer.desktop && \
    chmod +x /config/Desktop/*.desktop
