ARG GO_IMAGE=golang:1.26.10-alpine@sha256:27f2d3b83cfc5803c8078f8e730af0f7c431bf067afaec8f60a36fb763187cba
FROM ${GO_IMAGE} AS dnp3-builder
ENV GOTOOLCHAIN=local
WORKDIR /src
COPY dnp3go/ .
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    CGO_ENABLED=0 go build -o /dnp3poll ./cmd/dnp3poll \
 && CGO_ENABLED=0 go build -o /dnp3cmd ./cmd/dnp3cmd

# IEC 104 CLI: standalone static Go build, independent of the service image.
FROM ${GO_IMAGE} AS iec104cmd-builder
ENV CGO_ENABLED=0 GOTOOLCHAIN=local GOPROXY=off
WORKDIR /src/iec104go
COPY iec104go/go.mod iec104go/*.go ./
COPY iec104go/cmd/iec104cmd/ ./cmd/iec104cmd/
RUN go build -trimpath -o /out/iec104cmd ./cmd/iec104cmd

FROM linuxserver/webtop:ubuntu-mate@sha256:22b9ba5052a2cc584ea3753714d098ed9f885e3aa0e8fa87753d6f6328ccc793

# Install OT analysis tools and Modbus testing
# The current webtop snapshot still predates Ubuntu's Brotli fix.
RUN apt-get update && \
    apt-get install -y --only-upgrade libbrotli1 && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        iproute2 \
        mbpoll \
        nmap \
        python3 \
        python3-pip \
        tcpdump \
        tshark \
        wireshark && \
    pip3 install --no-cache-dir --break-system-packages pymodbus==3.16.1 && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Install DNP3 CLI tools
COPY --from=dnp3-builder /dnp3poll /usr/local/bin/dnp3poll
COPY --from=dnp3-builder /dnp3cmd /usr/local/bin/dnp3cmd

# IEC 104 CLI (Apache-2.0); unrelated base-image components retain their licences.
COPY --from=iec104cmd-builder /out/iec104cmd /usr/local/bin/iec104cmd
COPY iec104go/LICENSE /usr/share/licenses/iec104/LICENSE

# Create MATE desktop shortcuts and a pcaps directory
RUN mkdir -p /config/Desktop /home/abc/pcaps && \
    printf '%s\n' \
        '[Desktop Entry]' \
        'Type=Application' \
        'Name=Wireshark' \
        'Comment=Network Protocol Analyzer' \
        'Exec=wireshark' \
        'Icon=wireshark' \
        'Terminal=false' \
        'Categories=Network;' \
        > /config/Desktop/wireshark.desktop && \
    printf '%s\n' \
        '[Desktop Entry]' \
        'Type=Application' \
        'Name=PCAP Analyzer' \
        'Comment=EmberOT OT PCAP Analyzer' \
        'Exec=sh -c "exec $(find /opt -name \"pcap-analyzer\" -o -name \"PCAP Analyzer\" 2>/dev/null | head -1) || echo No PCAP Analyzer found"' \
        'Terminal=false' \
        'Categories=Network;' \
        > /config/Desktop/pcap-analyzer.desktop && \
    chmod +x /config/Desktop/*.desktop
